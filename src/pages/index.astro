---
import '../styles/global.css';

import {
  getProfile,
  getPublications,
  getProjects,
  getNews,
} from '../lib/content';

const [profile, publications, projects, news] = await Promise.all([
  getProfile(),
  getPublications(),
  getProjects(),
  getNews(),
]);

const currentYear = new Date().getFullYear();
const metaDescription = profile.bio.split('\n')[0].slice(0, 120);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <title>{profile.name} | 学术主页</title>
  </head>
  <body>
    <div class="site-shell">
      <main class="site-main">
        <section id="top" class="hero" aria-labelledby="hero-name">
          <header class="hero-heading">
            <h1 id="hero-name" class="hero-name">{profile.name}</h1>
            <p class="hero-title">{profile.title}</p>
            <p class="hero-affiliation">{profile.affiliation}</p>
          </header>

          <p class="hero-bio">{profile.bio}</p>

          <ul class="contact-list">
            <li>
              <a href={`mailto:${profile.email}`}>{profile.email}</a>
            </li>
            {profile.github && (
              <li>
                <a href={profile.github} target="_blank" rel="noopener noreferrer">
                  GitHub
                </a>
              </li>
            )}
            {profile.scholar_url && (
              <li>
                <a href={profile.scholar_url} target="_blank" rel="noopener noreferrer">
                  Google Scholar
                </a>
              </li>
            )}
          </ul>

          <nav class="section-nav" aria-label="页内导航">
            <ul class="nav-list">
              <li><a href="#publications">Publications</a></li>
              <li><a href="#projects">Projects</a></li>
              <li><a href="#news">News</a></li>
            </ul>
          </nav>
        </section>

        <section id="publications" class="content-section" aria-labelledby="publications-heading">
          <h2 id="publications-heading" class="section-title">Publications</h2>
          <ol class="entry-list publications-list">
            {publications.map(({ data }) => (
              <li class="publication-item">
                <article class="publication">
                  <h3 class="entry-title">
                    {data.selected && (
                      <span class="selected-marker" role="img" aria-label="精选论文">★</span>
                    )}
                    {data.title}
                  </h3>
                  <p class="entry-meta">
                    {data.authors.join('、')} · {data.venue} · {data.year}
                  </p>
                  {(data.paper_url || data.code_url) && (
                    <ul class="entry-links">
                      {data.paper_url && (
                        <li>
                          <a href={data.paper_url} target="_blank" rel="noopener noreferrer">
                            Paper
                          </a>
                        </li>
                      )}
                      {data.code_url && (
                        <li>
                          <a href={data.code_url} target="_blank" rel="noopener noreferrer">
                            Code
                          </a>
                        </li>
                      )}
                    </ul>
                  )}
                </article>
              </li>
            ))}
          </ol>
        </section>

        <section id="projects" class="content-section" aria-labelledby="projects-heading">
          <h2 id="projects-heading" class="section-title">Projects</h2>
          <ol class="entry-list projects-list">
            {projects.map(({ data }) => (
              <li class="project-item">
                <article class="project">
                  <header class="project-heading">
                    <h3 class="entry-title">{data.name}</h3>
                    <p class="project-years">
                      {data.start_year}–{data.end_year ?? '至今'}
                    </p>
                  </header>
                  <p class="project-description">{data.description}</p>
                  <ul class="tag-list" aria-label="技术栈与方法">
                    {data.tech_stack.map((tech) => (
                      <li class="tech-tag">{tech}</li>
                    ))}
                  </ul>
                  {(data.repo_url || data.demo_url) && (
                    <ul class="entry-links">
                      {data.repo_url && (
                        <li>
                          <a href={data.repo_url} target="_blank" rel="noopener noreferrer">
                            Repository
                          </a>
                        </li>
                      )}
                      {data.demo_url && (
                        <li>
                          <a href={data.demo_url} target="_blank" rel="noopener noreferrer">
                            Demo
                          </a>
                        </li>
                      )}
                    </ul>
                  )}
                </article>
              </li>
            ))}
          </ol>
        </section>

        <section id="news" class="content-section" aria-labelledby="news-heading">
          <h2 id="news-heading" class="section-title">News</h2>
          <ol class="entry-list news-list">
            {news.slice(0, 5).map(({ data }) => (
              <li class="news-item">
                <time class="news-date" datetime={data.date}>{data.date}</time>
                <p class="news-content">{data.content}</p>
              </li>
            ))}
          </ol>
        </section>
      </main>

      <footer class="site-footer">
        <p class="footer-contact">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>
        <p class="copyright">© {currentYear} {profile.name}</p>
      </footer>
    </div>
  </body>
</html>
